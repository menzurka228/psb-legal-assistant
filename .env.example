# 1 — ответы выдержками из локальной базы для демонстрации без модели.
DEMO_MODE=0

# OpenAI-совместимый API (на платформе хакатона — API организаторов). Ключи — только здесь, не в git.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your-key-here
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_TEMPERATURE=0
MAX_TOKENS=1500
LLM_TIMEOUT_SEC=120

# Эмбеддинги и реранкер (по умолчанию тот же ключ)
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b
USE_EMBEDDINGS=1
# EMBEDDER_API_KEY=
# RERANKER_API_KEY=

# Поиск и проверка
LAW_TOP_N=8
LAW_CANDIDATES=30
SELF_CHECK=0

# Порт веб-интерфейса на хосте
PORT=8000
