# OpenAI-совместимый API языковой модели (на платформе — DeepSeek V4.1 Flash через API организаторов)
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your-key-here
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SEC=60

# Поиск
TOP_K=8
MIN_SCORE=1.0

# Порт веб-интерфейса на хосте
PORT=8000
